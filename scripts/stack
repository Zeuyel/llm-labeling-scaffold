#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

if ! command -v docker >/dev/null 2>&1; then
  echo "docker is required but was not found in PATH." >&2
  exit 1
fi

if ! docker compose version >/dev/null 2>&1; then
  echo "docker compose is required but is not available." >&2
  exit 1
fi

if [ ! -f .env ]; then
  cp .env.example .env
  echo "已从 .env.example 创建 .env"
fi

env_value() {
  local name="$1"
  local fallback="$2"
  local value="${!name:-}"

  if [ -z "$value" ]; then
    value="$(grep -E "^${name}=" .env 2>/dev/null | tail -n 1 | cut -d= -f2- || true)"
  fi

  if [ -n "$value" ]; then
    printf '%s' "$value"
  else
    printf '%s' "$fallback"
  fi
}

usage() {
  cat >&2 <<'EOF'
用法：scripts/stack [up|down|logs|ps|restart] [--mlflow] [--mcp]

默认启动 light panel 和 Argilla 标注服务。
如需可选模型记录服务，使用：scripts/stack up --mlflow
如需 MCP companion service，使用：scripts/stack up --mcp
EOF
}

cmd="${1:-up}"
if [ "$#" -gt 0 ]; then
  shift
fi

enable_mlflow=0
enable_mcp=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --mlflow|--profile=mlflow)
      enable_mlflow=1
      shift
      ;;
    --profile)
      if [ "${2:-}" = "mlflow" ]; then
        enable_mlflow=1
        shift 2
      elif [ "${2:-}" = "mcp" ]; then
        enable_mcp=1
        shift 2
      else
        usage
        exit 2
      fi
      ;;
    --mcp|--profile=mcp)
      enable_mcp=1
      shift
      ;;
    *)
      usage
      exit 2
      ;;
  esac
done

apply_config=0
case "$cmd" in
  up|restart)
    apply_config=1
    ;;
esac

if [ "$enable_mcp" -eq 1 ] && [ "$apply_config" -eq 1 ]; then
  mcp_bearer_token="$(env_value LLS_MCP_BEARER_TOKEN "")"
  mcp_internal_token="$(env_value LLS_MCP_INTERNAL_TOKEN "")"
  if [ "${#mcp_bearer_token}" -lt 32 ] || [[ "$mcp_bearer_token" =~ [[:space:]] ]] || [ "${#mcp_internal_token}" -lt 32 ] || [[ "$mcp_internal_token" =~ [[:space:]] ]] || [ "$mcp_bearer_token" = "$mcp_internal_token" ]; then
    echo "启用 MCP 前必须设置彼此不同、至少 32 个非空白字符的 LLS_MCP_BEARER_TOKEN 和 LLS_MCP_INTERNAL_TOKEN。" >&2
    exit 2
  fi
fi

panel_auth_mode="$(env_value LLS_PANEL_AUTH_MODE cloudflare_access)"
panel_bind_host="$(env_value PANEL_BIND_HOST 127.0.0.1)"
if [ "$apply_config" -eq 1 ]; then
  case "${panel_auth_mode,,}" in
    basic_dev)
      if [ -z "$(env_value LLS_PANEL_PASSWORD "")" ]; then
        echo "basic_dev 模式必须设置 LLS_PANEL_PASSWORD。" >&2
        exit 2
      fi
      case "$panel_bind_host" in
        127.0.0.1|::1)
          ;;
        localhost)
          panel_bind_host="127.0.0.1"
          ;;
        *)
          echo "basic_dev 模式只允许 PANEL_BIND_HOST 使用 127.0.0.1、localhost 或 ::1。" >&2
          exit 2
          ;;
      esac
      ;;
    cloudflare_access)
      if [ -z "$(env_value LLS_CF_ACCESS_ISSUER "")" ] || [ -z "$(env_value LLS_CF_ACCESS_AUD "")" ]; then
        echo "cloudflare_access 模式必须设置 LLS_CF_ACCESS_ISSUER 和 LLS_CF_ACCESS_AUD。" >&2
        exit 2
      fi
      ;;
    *)
      echo "LLS_PANEL_AUTH_MODE 只能是 cloudflare_access 或 basic_dev。" >&2
      exit 2
      ;;
  esac
  export PANEL_BIND_HOST="$panel_bind_host"
fi

if [ "$apply_config" -eq 1 ]; then
  database_owner_password="$(env_value SCAFFOLD_POSTGRES_OWNER_PASSWORD "")"
  database_app_password="$(env_value SCAFFOLD_POSTGRES_APP_PASSWORD "")"
  if [ -z "$database_owner_password" ] || [ -z "$database_app_password" ]; then
    echo "up/restart 前必须设置 SCAFFOLD_POSTGRES_OWNER_PASSWORD 和 SCAFFOLD_POSTGRES_APP_PASSWORD。" >&2
    exit 2
  fi
  if [ "$database_owner_password" = "$database_app_password" ]; then
    echo "数据库 owner 和 app role 必须使用不同密码。" >&2
    exit 2
  fi
fi

task_source="$(env_value LLS_TASK_SOURCE control)"
compose=(docker compose -f docker-compose.yml)
case "${task_source,,}" in
  local)
    ;;
  *)
    compose+=(-f docker-compose.rclone.example.yml)
    ;;
esac
services=(scaffold-postgres db-role-init migrate panel argilla argilla-worker argilla-postgres elasticsearch redis)
if [ "$enable_mlflow" -eq 1 ]; then
  compose+=(--profile mlflow)
  services+=(mlflow)
fi
if [ "$enable_mcp" -eq 1 ]; then
  compose+=(--profile mcp)
  services+=(mcp)
fi

print_urls() {
  local registry_uri
  local data_lake_prefix

  echo
  echo "light panel： http://localhost:$(env_value PANEL_PORT 8765)"
  echo "Argilla：     http://localhost:$(env_value ARGILLA_PORT 6900)"
  if [ "$enable_mlflow" -eq 1 ]; then
    echo "模型记录服务： http://localhost:$(env_value MLFLOW_PORT 5000)"
  fi
  if [ "$enable_mcp" -eq 1 ]; then
    echo "MCP：         http://localhost:$(env_value MCP_PORT 8766)/mcp"
  fi
  echo
  if [ "${panel_auth_mode,,}" = "basic_dev" ]; then
    echo "panel 本地开发登录：admin / $(env_value LLS_PANEL_PASSWORD changeme)"
  else
    echo "panel 登录：Cloudflare Access"
  fi
  echo "Argilla 登录：$(env_value ARGILLA_USERNAME argilla) / $(env_value ARGILLA_PASSWORD 12345678)"
  if [ "$enable_mlflow" -eq 0 ]; then
    echo
    echo "默认未启动模型记录服务；需要时运行：scripts/stack up --mlflow"
  fi
  if [ "$enable_mcp" -eq 0 ]; then
    echo
    echo "默认未启动 MCP；需要时先配置 LLS_MCP_BEARER_TOKEN 和 LLS_MCP_INTERNAL_TOKEN，再运行：scripts/stack up --mcp"
  fi
  case "${task_source,,}" in
    r2|data_lake|registry)
      registry_uri="$(env_value LLS_TASK_REGISTRY_URI "")"
      data_lake_prefix="$(env_value LLS_DATA_LAKE_R2_PREFIX "")"
      echo
      echo "首次部署：进入 light panel 的“系统设置”，填写 task_registry_uri 和 data_lake_r2_prefix，然后同步任务配置。"
      echo "R2 访问只通过 rclone；容器只读挂载宿主机 rclone.conf，不把密钥写进镜像。"
      if [[ "$registry_uri" == *YOUR_BUCKET* || "$data_lake_prefix" == *YOUR_BUCKET* ]]; then
        echo "注意：.env 仍是 YOUR_BUCKET 占位值，请替换为自己的 R2 registry。"
      fi
      ;;
    control|scaffold|panel)
      echo
      echo "任务来源：scaffold 控制面。任务草稿和 revision 保存在 runs/_system/task_control/；无需同步 R2 task registry。"
      echo "控制面任务访问 R2 数据湖时，仍通过只读挂载的 rclone.conf 读取数据，不把密钥写进镜像。"
      ;;
  esac
}

case "$cmd" in
  up)
    if [ "$enable_mlflow" -eq 1 ]; then
      MLFLOW_TRACKING_URI="${MLFLOW_TRACKING_URI:-http://mlflow:5000}" "${compose[@]}" up -d --build
    else
      "${compose[@]}" up -d --build
    fi
    print_urls
    ;;
  down)
    "${compose[@]}" down
    ;;
  logs)
    "${compose[@]}" logs -f "${services[@]}"
    ;;
  ps)
    "${compose[@]}" ps
    ;;
  restart)
    if [ "$enable_mlflow" -eq 1 ]; then
      MLFLOW_TRACKING_URI="${MLFLOW_TRACKING_URI:-http://mlflow:5000}" "${compose[@]}" up -d --force-recreate "${services[@]}"
    else
      "${compose[@]}" up -d --force-recreate "${services[@]}"
    fi
    ;;
  *)
    usage
    exit 2
    ;;
esac
