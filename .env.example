# loopback 通过固定 override 仅发布 127.0.0.1；生产 sidecar Tunnel 使用 tunnel，不发布宿主端口。
LLS_DEPLOYMENT_MODE=loopback
PANEL_PORT=8765
# 仅供本地开发；生产部署改为 cloudflare_access，不能依赖 Basic Auth 回退。
LLS_PANEL_AUTH_MODE=basic_dev
LLS_PANEL_PASSWORD=changeme

# Cloudflare Access 生产配置。issuer 必须是 team domain，AUD 是 Access application 的 Audience Tag。
# LLS_DEPLOYMENT_MODE=tunnel
# LLS_PANEL_AUTH_MODE=cloudflare_access
# LLS_CF_ACCESS_ISSUER=https://YOUR_TEAM.cloudflareaccess.com
# LLS_CF_ACCESS_AUD=
# LLS_CF_ACCESS_JWKS_TTL_SECONDS=300
# LLS_CF_ACCESS_HTTP_TIMEOUT_SECONDS=5
# LLS_CF_ACCESS_CLOCK_SKEW_SECONDS=0

# Scaffold 自有数据库。它与 Argilla PostgreSQL 使用不同服务、数据库和持久卷。
SCAFFOLD_POSTGRES_BIND_HOST=127.0.0.1
SCAFFOLD_POSTGRES_PORT=5433
SCAFFOLD_POSTGRES_OWNER_USER=scaffold_owner
SCAFFOLD_POSTGRES_APP_USER=scaffold_app
# CHANGE_ME_OWNER_PASSWORD：用 `openssl rand -hex 32` 生成后替换空值。
SCAFFOLD_POSTGRES_OWNER_PASSWORD=
# CHANGE_ME_APP_PASSWORD：再次独立生成，不要复用或提交任一密码。
SCAFFOLD_POSTGRES_APP_PASSWORD=
SCAFFOLD_POSTGRES_DB=scaffold
# 任一密码为空时 Compose 会拒绝启动；migrate 使用 owner，Panel 仅使用受限 app role。

# 首位管理员只能用显式 bootstrap 命令或以下配置创建，subject 不能替换为邮箱。
# LLS_BOOTSTRAP_ISSUER=https://example.cloudflareaccess.com
# LLS_BOOTSTRAP_SUBJECT=<stable-access-subject>
# LLS_BOOTSTRAP_WORKSPACE_SLUG=default
# LLS_BOOTSTRAP_WORKSPACE_NAME=Default Workspace

# 可选 MCP companion service。只有 scripts/stack up --mcp 或 docker compose --profile mcp 时启动。
MCP_PORT=8766
# stack 模式只允许回环发布；生产通过 Cloudflare Tunnel 连接该源站端口。
MCP_BIND_HOST=127.0.0.1
# 生产默认使用独立 MCP Access application。其 AUD 必须与 LLS_CF_ACCESS_AUD 不同。
LLS_MCP_AUTH_MODE=cloudflare_access
LLS_MCP_CF_ACCESS_ISSUER=
LLS_MCP_CF_ACCESS_AUD=
LLS_MCP_CF_ACCESS_JWKS_TTL_SECONDS=300
LLS_MCP_CF_ACCESS_HTTP_TIMEOUT_SECONDS=5
LLS_MCP_CF_ACCESS_CLOCK_SKEW_SECONDS=0
# MCP 到 Panel 的独立内部服务凭据；所有模式都必须设置。
LLS_MCP_INTERNAL_TOKEN=
# 仅本地开发可改为 static_dev，并设置独立高熵 bearer；生产不得回退到该模式。
# LLS_MCP_AUTH_MODE=static_dev
LLS_MCP_BEARER_TOKEN=
# 默认只读；仅在受控部署中显式开启任务草稿、发布和数据湖导入写操作。
LLS_MCP_ENABLE_WRITES=0
LLS_MCP_TIMEOUT_SECONDS=15

ARGILLA_PORT=6900
ARGILLA_USERNAME=argilla
ARGILLA_PASSWORD=12345678
ARGILLA_API_KEY=argilla.apikey
ARGILLA_WORKSPACE=argilla
ARGILLA_BACKGROUND_WORKERS=2

# 低配测试机默认给 Elasticsearch 较小堆内存；生产机器建议调高到 -Xms512m -Xmx512m。
ELASTICSEARCH_JAVA_OPTS=-Xms256m -Xmx256m

# 可选模型记录服务，仅在启用 Docker Compose 的 mlflow profile 时使用。
MLFLOW_PORT=5000
# 默认不向 panel 注入模型记录地址；scripts/stack up --mlflow 会临时设置。
# MLFLOW_TRACKING_URI=http://mlflow:5000

# 任务来源：r2 从 R2 registry 同步任务；control 由 scaffold 控制面管理任务单和 revision；local 仅供开发测试。
# R2 数据湖访问只通过 rclone。control 模式下 R2 仅用于任务的数据湖输入和产物读写，不作为任务单来源。
LLS_TASK_SOURCE=control
# r2 模式必须改为本部署自己的数据湖治理登记表；下面是占位格式，不是可直接使用的 bucket。
# LLS_TASK_REGISTRY_URI / task_registry_uri 一般指向 data_lake.yaml，不是某个 task.yaml；control 模式仅将其作为数据湖 registry 默认配置。
# r2 模式具体任务文件由登记表中的 tasks.<task_id>.task_uri 指向。
LLS_TASK_REGISTRY_URI=r2:YOUR_BUCKET/governance/data_lake/v1/current/data_lake.yaml
LLS_DATA_LAKE_R2_PREFIX=r2:YOUR_BUCKET/
# 示例：
# LLS_TASK_REGISTRY_URI=r2:labeling-lake/governance/data_lake/v1/current/data_lake.yaml
# LLS_DATA_LAKE_R2_PREFIX=r2:labeling-lake/
# Docker 部署时请把宿主机 rclone.conf 只读映射到容器，不要把密钥写进镜像。
# RCLONE_CONFIG_HOST=${HOME}/.config/rclone/rclone.conf
# RCLONE_CONFIG=/run/secrets/rclone/rclone.conf
LLS_RCLONE_TIMEOUT_SECONDS=120
# 生产模式以 R2 数据湖为权威，只 materialize 任务级输入；手动上传/粘贴导入默认关闭，只给开发排查开启。
# 生产默认不允许面板覆盖数据湖来源；只在开发排查时设置为 1。
# LLS_ALLOW_DATA_LAKE_OVERRIDES=1
# 生产默认只允许访问 LLS_DATA_LAKE_R2_PREFIX 下的 R2 URI；本地路径只给单测使用。
# LLS_ALLOW_LOCAL_DATA_LAKE_URIS=1

PIP_INDEX_URL=https://repo.huaweicloud.com/repository/pypi/simple
PIP_TRUSTED_HOST=repo.huaweicloud.com
